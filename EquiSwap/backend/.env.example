# Copy this file to .env and replace values.
# Example:
# cp .env.example .env

# URL-encode special password characters, e.g. @ -> %40 and ! -> %21
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/equiswap_dev

JWT_SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
